{
  "name": "mentor-plateforme",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "predev": "pnpm run check:node",
    "prebuild": "pnpm run check:node",
    "prestart": "pnpm run check:node",
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/check-persistent-storage.mjs && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "verify": "pnpm run check && pnpm run build",
    "tsx": "node scripts/run-tsx.mjs",
    "mcq:import": "node scripts/run-tsx.mjs scripts/import-mcq-corpus.ts",
    "source-version-alias": "node scripts/run-tsx.mjs scripts/source-version-editorial-alias.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.26.0",
    "@napi-rs/canvas": "1.0.8",
    "@tailwindcss/postcss": "4.3.3",
    "@tesseract.js-data/fra": "1.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.28.0",
    "mammoth": "^1.12.1",
    "next": "16.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "tsx": "4.20.6",
    "vitest": "4.1.10"
  }
}
