# Réservé à un futur connecteur IA. La version actuelle utilise uniquement le moteur local.
# Ajouter une valeur ici n’active pas encore OpenAI.
OPENAI_API_KEY=
AI_DAILY_BUDGET_CAD=2.00

# 1 conserve le jeu de démonstration au premier démarrage; 0 crée une base vide.
MENTOR_ENABLE_DEMO_DATA=1

# Optionnel : chemin absolu pour isoler une exécution de test/build.
MENTOR_DATA_DIRECTORY=
