# Réservé à un futur connecteur IA. La version actuelle utilise uniquement le moteur local.
# Ajouter une valeur ici n’active pas encore OpenAI.
OPENAI_API_KEY=
AI_DAILY_BUDGET_CAD=2.00

# Production : conserver impérativement 0. La valeur 1 est réservée à la démonstration locale.
MENTOR_ENABLE_DEMO_DATA=0

# Optionnel : chemin absolu pour isoler une exécution de test/build.
MENTOR_DATA_DIRECTORY=
MENTOR_REQUIRE_PERSISTENT_STORAGE=0
MENTOR_PERSISTENT_MOUNT_PATH=

# Auth0 — placeholders uniquement. Ne jamais committer de valeurs réelles.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=replace-with-32-byte-hex-secret
APP_BASE_URL=http://localhost:3000

# Pilote fermé — valeurs réelles exclusivement dans l'environnement serveur Render.
MENTOR_PILOT_PROVISIONER_SUBJECTS=
MENTOR_PILOT_OSCE_SESSION_LIMIT=
MENTOR_PILOT_AI_REQUEST_LIMIT=
MENTOR_PILOT_QUOTA_WINDOW_DAYS=
MENTOR_PILOT_AUDIT_KEY=
